# ============================================================
# Department Inventory Management System — Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/dept_inventory
MONGODB_DB_NAME=dept_inventory

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Demo Seed Accounts (development only) ---
SEED_COORDINATOR_EMAIL=coordinator@demo.edu
SEED_COORDINATOR_PASSWORD=Demo@1234
SEED_STUDENT_PASSWORD=Student@1234

# --- Timezone ---
INSTITUTION_TIMEZONE=Asia/Kolkata

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
